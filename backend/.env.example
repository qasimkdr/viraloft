# Copy this file to ".env" in the backend/ folder and fill in real values.
# Without MONGO_URI and JWT_SECRET, the server will refuse to start.

# ---- Required ----
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/viraloft
JWT_SECRET=replace-with-a-long-random-string   # e.g. `openssl rand -hex 32`
PORT=5000

# ---- Vendor SMM API (needed for /api/services and /api/orders to work) ----
# Without these, the site still runs (login, admin, support, dashboards all
# work), but the services list / ordering will return a 503 until set.
SMM_API_URL=https://your-provider.example.com/api/v2
SMM_API_KEY=your-provider-api-key

# ---- Outgoing email (verification codes) via SMTP (e.g. Brevo) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Viraloft <no-reply@viraloft.com>"
MAIL_REPLY_TO="Viraloft Support <support@viraloft.com>"

# ---- Security ----
NODE_ENV=production
# Comma-separated list of allowed frontend origins in production.
# Leave unset in local dev to allow all origins.
CORS_ORIGIN=https://yourdomain.com
